# ==========================================
# Vehicle Rental System - Docker Environment
# ==========================================

# Port mappings on host
FRONTEND_PORT=3000
BACKEND_PORT=3001
POSTGRES_PORT=5433

# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vehicle_rental_db

# Connection string used by backend container (connects to postgres service within Docker network)
CONNECTION_STRING=postgresql://postgres:postgres@postgres:5432/vehicle_rental_db

# JWT Secret for backend authentication
JWT_SECRET=bee6e12150de7ffac789c64b1b8402b3f2745e84df6401ab9b8d2eb41c491e90

# Frontend public API target (accessed from browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_FALLBACK_API_URL=https://vehical-rental-system-five.vercel.app/api/v1
